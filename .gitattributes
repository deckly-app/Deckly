# Auto detect text files and perform LF normalization
* text=auto
# Package files and scripts run on Unix tools (bash, makepkg, sh) and break
# with Windows line endings, so they stay LF in every checkout.
packaging/** text eol=lf
*.sh text eol=lf
# Installed on Linux as is, and read by the install tests on every system.
assets/linux/** text eol=lf
# Embedded into deckly-cli and written out as new plugin projects; the tests
# compare their exact text, so they stay LF on Windows checkouts too.
crates/deckly-cli/templates/** text eol=lf
